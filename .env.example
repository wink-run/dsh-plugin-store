# DSH Store deployment configuration
# Copy to .env and adjust.

# Public domain the store is served under (nginx server_name + certificate CN).
# Leave as localhost for a local test with self-signed certs.
DOMAIN=store.example.com

# Paths to the TLS certificate chain and private key inside the container.
# The ./certs volume is mounted at /etc/nginx/certs by docker-compose.yml.
SSL_CERT=/etc/nginx/certs/fullchain.pem
SSL_KEY=/etc/nginx/certs/privkey.pem
